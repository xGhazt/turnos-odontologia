# Copiar a `.env` y completar con valores locales. NUNCA commitear secretos reales.

# PostgreSQL (usado por docker-compose)
POSTGRES_USER=turnos
POSTGRES_PASSWORD=cambiar
POSTGRES_DB=turnos

# Backend
DATABASE_URL=postgresql+asyncpg://turnos:cambiar@localhost:5432/turnos
REDIS_URL=redis://localhost:6379/0
CORS_ORIGINS=http://localhost:5173
APP_PORT=8000
LOG_LEVEL=INFO
