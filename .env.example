# Copiar a `.env` y completar con valores locales. NUNCA commitear secretos reales.

POSTGRES_USER=turnos
POSTGRES_PASSWORD=CAMBIAR_ESTA_CLAVE_LOCAL
POSTGRES_DB=turnos_odontologia

DATABASE_URL=postgresql+asyncpg://turnos:CAMBIAR_ESTA_CLAVE_LOCAL@localhost:5432/turnos_odontologia

REDIS_URL=redis://localhost:6379/0

# Variables de configuración JWT (C-03 auth-system)
SECRET_KEY=SUSTITUIR_POR_CLAVE_SECRETA_SEGURA
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30